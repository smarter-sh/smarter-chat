{
  "name": "@smarter.sh/ui-chat",
  "version": "0.4.0",
  "description": "chatbot React.js component for the https://smarter.sh declarative, plugin-based AI resource management platform.",
  "homepage": "https://smarter.sh",
  "type": "module",
  "main": "./dist/smarter-chat-library.umd.js",
  "module": "./dist/smarter-chat-library.es.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/smarter-chat-library.es.js",
      "require": "./dist/smarter-chat-library.umd.js"
    },
    "./dist/ui-chat.css": "./dist/ui-chat.css",
    "./style.css": "./dist/ui-chat.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "react",
    "component",
    "chatbot",
    "ai",
    "smarter"
  ],
  "author": "Lawrence McDaniel <lpm0073@gmail.com>, (https://lawrencemcdaniel.com/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smarter-sh/smarter-chat.git"
  },
  "bugs": {
    "url": "https://github.com/smarter-sh/smarter-chat/issues"
  },
  "contributors": [
    "Lawrence McDaniel <lpm0073@gmail.com> (https://lawrencemcdaniel.com/)"
  ],
  "engines": {
    "node": ">=20.17.0",
    "npm": ">=10.8.2"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/lpm0073"
  },
  "scripts": {
    "dev": "NODE_ENV=dev && vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --mode lib && tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "@chatscope/chat-ui-kit-react": "^2.1.1",
    "@chatscope/chat-ui-kit-styles": "^1.4.0",
    "@microlink/react-json-view": "^1.31.40"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
